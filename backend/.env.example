# SideDoor Backend — Environment Variables
# Copy to .env and fill in values.

# Postgres connection (Local or Supabase Pooler)
# Local: postgresql+asyncpg://sidedoor:sidedoor@localhost:5432/sidedoor
# Supabase Pooler: postgresql://postgres.[project-ref]:[password]@aws-1-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres.your_project_ref:your_password@aws-1-ap-south-1.pooler.supabase.com:6543/postgres

# LLM provider for resume parsing (the one deliberate LLM call)
LLM_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key-here

# Embedding model (local, no API key needed)
EMBEDDING_MODEL=all-MiniLM-L6-v2
