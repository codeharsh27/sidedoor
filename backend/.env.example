# SideDoor Backend — Environment Variables
# Copy to .env and fill in values.

# Postgres connection (with pgvector extension enabled)
DATABASE_URL=postgresql+asyncpg://sidedoor:sidedoor@localhost:5432/sidedoor

# LLM provider for resume parsing (the one deliberate LLM call)
LLM_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key-here

# Embedding model (local, no API key needed)
EMBEDDING_MODEL=all-MiniLM-L6-v2
